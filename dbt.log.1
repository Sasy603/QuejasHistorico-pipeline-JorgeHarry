create or replace   view RETAILCO_DEV.staging.stg_web_site
  
  
  
  
  as (
    

select
    coalesce(web_site_sk::integer, -1)              as web_site_sk,
    coalesce(web_site_id, 'UNKNOWN')               as web_site_id,

    web_rec_start_date                              as record_start_date,
    web_rec_end_date                                as record_end_date,

    coalesce(nullif(trim(web_name), ''), 'UNKNOWN') as site_name,

    coalesce(web_open_date_sk::integer, -1)         as open_date_sk,
    coalesce(web_close_date_sk::integer, -1)        as close_date_sk,

    coalesce(nullif(trim(web_class), ''), 'UNKNOWN') as site_class,
    coalesce(nullif(trim(web_manager), ''), 'UNKNOWN') as site_manager,

    coalesce(web_mkt_id::integer, -1)               as marketing_id,
    coalesce(nullif(trim(web_mkt_class), ''), 'UNKNOWN') as marketing_class,
    coalesce(nullif(trim(web_mkt_desc), ''), 'UNKNOWN')  as marketing_description,
    coalesce(nullif(trim(web_market_manager), ''), 'UNKNOWN') as marketing_manager,

    coalesce(web_company_id::integer, -1)           as company_id,
    coalesce(nullif(trim(web_company_name), ''), 'UNKNOWN') as company_name,

    coalesce(nullif(trim(web_street_number), ''), 'UNKNOWN') as street_number,
    coalesce(nullif(trim(web_street_name), ''), 'UNKNOWN')   as street_name,
    coalesce(nullif(trim(web_street_type), ''), 'UNKNOWN')   as street_type,
    coalesce(nullif(trim(web_suite_number), ''), 'UNKNOWN')  as suite_number,

    coalesce(nullif(trim(web_city), ''), 'UNKNOWN')   as city,
    coalesce(nullif(trim(web_county), ''), 'UNKNOWN') as county,
    coalesce(nullif(trim(web_state), ''), 'UNKNOWN')  as state,
    coalesce(nullif(trim(web_zip), ''), 'UNKNOWN')    as zip_code,
    coalesce(nullif(trim(web_country), ''), 'UNKNOWN') as country,

    web_gmt_offset                                   as gmt_offset,
    web_tax_percentage                               as tax_percentage

from RETAILCO_DEV.RAW.web_site
  )
