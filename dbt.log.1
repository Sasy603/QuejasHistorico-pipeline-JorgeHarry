    coalesce(cp_start_date_sk::integer, -1)            as start_date_sk,
    coalesce(cp_end_date_sk::integer, -1)              as end_date_sk,

    coalesce(nullif(trim(cp_department), ''), 'UNKNOWN')       as department,
    coalesce(cp_catalog_number, 0)                     as catalog_number,
    coalesce(cp_catalog_page_number, 0)                as page_number,
    coalesce(nullif(trim(cp_description), ''), 'UNKNOWN')      as description,
    coalesce(nullif(trim(cp_type), ''), 'UNKNOWN')             as page_type

from RETAILCO_DEV.RAW.CATALOG_PAGE
  )
