14:35:11.497900 [debug]: Writing runtime sql for node "model.jaffle_shop.marts_sales_by_channel"
14:35:11.990478 [debug]: Query executed on node model.jaffle_shop.marts_sales_by_channel:
create or replace transient  table RETAILCO_DEV.marts.marts_sales_by_channel
    
    
    
    as (

WITH sales AS (
    SELECT *
    FROM RETAILCO_DEV.RAW.int_unified_sales
),

joined AS (
    SELECT
        s.sales_channel,
        d.year AS year,
        d.month_of_year AS month,
        i.category_id AS product_category,

        CASE
            WHEN s.sales_channel = 'store' THEN st.store_name
            WHEN s.sales_channel = 'web'   THEN ws.site_name
            WHEN s.sales_channel = 'catalog' THEN cp.catalog_page_id
        END AS location_name,

        s.ext_sales_price,
        s.quantity,
        s.net_profit,
        s.net_paid

    FROM sales s
    LEFT JOIN RETAILCO_DEV.staging.stg_date_dim d
        ON s.sold_date_sk = d.date_sk
    LEFT JOIN RETAILCO_DEV.staging.stg_item i
        ON s.item_sk = i.item_sk
    LEFT JOIN RETAILCO_DEV.staging.stg_store st
        ON s.store_sk = st.store_sk
    LEFT JOIN RETAILCO_DEV.staging.stg_web_site ws
        ON s.web_site_sk = ws.web_site_sk
    LEFT JOIN RETAILCO_DEV.staging.stg_catalog_page cp
        ON s.catalog_page_sk = cp.catalog_page_sk
)

SELECT
    sales_channel,
    location_name,
    year,
    month,
    product_category,
    SUM(ext_sales_price) AS total_sales_amount,
    SUM(quantity)        AS total_units,
    SUM(net_profit)      AS total_profit,
    SUM(net_paid)        AS total_net_paid,
    COUNT(*) AS num_transactions
FROM joined
GROUP BY
    sales_channel,
    location_name,
    year,
    month,
    product_category
ORDER BY
    year,
    month,
    sales_channel,
    location_name,
    product_category
