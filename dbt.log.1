create or replace   view RETAILCO_DEV.staging.stg_date_dim
  
  
  
  
  as (
    

/*
    Este modelo estandariza la dimensión de fechas (date_dim)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (d_ → date_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis temporal (calendario, fiscal, flags de periodo).
*/

select
    -- Surrogate keys
    COALESCE(d_date_sk::INTEGER, -1) as date_sk,
    COALESCE(d_date_id::VARCHAR, 'UNKNOWN') as date_id,

    -- Fecha principal
    COALESCE(d_date::DATE, DATE '1900-01-01') as date_value,

    -- Secuencias de calendario
    COALESCE(d_month_seq::INTEGER, -1) as month_seq,
    COALESCE(d_week_seq::INTEGER, -1) as week_seq,
    COALESCE(d_quarter_seq::INTEGER, -1) as quarter_seq,

    -- Componentes de fecha
    COALESCE(d_year::INTEGER, -1) as year,
    COALESCE(d_dow::INTEGER, -1) as day_of_week,
    COALESCE(d_moy::INTEGER, -1) as month_of_year,
    COALESCE(d_dom::INTEGER, -1) as day_of_month,
    COALESCE(d_qoy::INTEGER, -1) as quarter_of_year,

    -- Año fiscal
    COALESCE(d_fy_year::INTEGER, -1) as fiscal_year,
    COALESCE(d_fy_quarter_seq::INTEGER, -1) as fiscal_quarter_seq,
    COALESCE(d_fy_week_seq::INTEGER, -1) as fiscal_week_seq,

    -- Atributos descriptivos
    COALESCE(NULLIF(TRIM(d_day_name), ''), 'UNKNOWN') as day_name,
    COALESCE(NULLIF(TRIM(d_quarter_name), ''), 'UNKNOWN') as quarter_name,

    -- Flags de calendario
    COALESCE(d_holiday::BOOLEAN, false) as is_holiday,
    COALESCE(d_weekend::BOOLEAN, false) as is_weekend,
    COALESCE(d_following_holiday::BOOLEAN, false) as is_following_holiday,

    -- Primer y último día del mes
    COALESCE(d_first_dom::INTEGER, -1) as first_day_of_month,
    COALESCE(d_last_dom::INTEGER, -1) as last_day_of_month,

    -- Comparativos
    COALESCE(d_same_day_ly::INTEGER, -1) as same_day_last_year,
    COALESCE(d_same_day_lq::INTEGER, -1) as same_day_last_quarter,

    -- Flags de periodo actual
    COALESCE(d_current_day::BOOLEAN, false) as is_current_day,
    COALESCE(d_current_week::BOOLEAN, false) as is_current_week,
    COALESCE(d_current_month::BOOLEAN, false) as is_current_month,
    COALESCE(d_current_quarter::BOOLEAN, false) as is_current_quarter,
    COALESCE(d_current_year::BOOLEAN, false) as is_current_year

from RETAILCO_DEV.RAW.date_dim
  )
