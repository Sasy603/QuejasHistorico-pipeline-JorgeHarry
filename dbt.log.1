    COALESCE(ws_net_paid_inc_tax::FLOAT, 0.0) as net_paid_incl_tax,
    COALESCE(ws_net_paid_inc_ship::FLOAT, 0.0) as net_paid_incl_shipping,
    COALESCE(ws_net_paid_inc_ship_tax::FLOAT, 0.0) as net_paid_incl_shipping_tax,

    -- Margen
