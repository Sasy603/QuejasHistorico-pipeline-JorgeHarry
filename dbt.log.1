create or replace   view RETAILCO_DEV.staging.stg_catalog_page
  
  
  
  
  as (
    

select
    coalesce(c_customer_sk::integer, -1)                     as customer_sk,
    coalesce(c_customer_id, 'UNKNOWN')                      as customer_id,
    coalesce(c_current_cdemo_sk::integer, -1)               as current_customer_demo_sk,
    coalesce(c_current_hdemo_sk::integer, -1)               as current_household_demo_sk,
    coalesce(c_current_addr_sk::integer, -1)                as current_address_sk,

    coalesce(c_first_shipto_date_sk::integer, -1)           as first_ship_date_sk,
    coalesce(c_first_sales_date_sk::integer, -1)            as first_sales_date_sk,

    coalesce(nullif(trim(c_salutation), ''), 'UNKNOWN')     as salutation,
    coalesce(nullif(trim(c_first_name), ''), 'UNKNOWN')     as first_name,
    coalesce(nullif(trim(c_last_name), ''), 'UNKNOWN')      as last_name,
    coalesce(nullif(trim(c_preferred_cust_flag), ''), 'N')  as preferred_customer_flag,

    coalesce(c_birth_day, 0)                                as birth_day,
    coalesce(c_birth_month, 0)                              as birth_month,
    coalesce(c_birth_year, 0)                               as birth_year,

    coalesce(nullif(trim(c_birth_country), ''), 'UNKNOWN')  as birth_country,
    coalesce(nullif(trim(c_login), ''), 'UNKNOWN')          as login,
    coalesce(nullif(trim(c_email_address), ''), 'UNKNOWN')  as email_address,

    coalesce(c_last_review_date, date '1900-01-01')         as last_review_date,

    date_from_parts(c_birth_year, c_birth_month, c_birth_day) as birth_date,

    datediff(
        year,
        date_from_parts(c_birth_year, c_birth_month, c_birth_day),
        current_date()
    ) as customer_age,

    case 
        when datediff(
            year,
            date_from_parts(c_birth_year, c_birth_month, c_birth_day),
            current_date()
        ) >= 18 then true
        else false
    end as is_adult,

    case
        when datediff(year, date_from_parts(c_birth_year, c_birth_month, c_birth_day), current_date()) < 18 then 'minor'
        when datediff(year, date_from_parts(c_birth_year, c_birth_month, c_birth_day), current_date()) between 18 and 34 then 'young_adult'
        when datediff(year, date_from_parts(c_birth_year, c_birth_month, c_birth_day), current_date()) between 35 and 54 then 'adult'
        else 'senior'
    end as age_group,

    split_part(email_address, '@', 2) as email_domain,

    datediff(
        year,
        to_date(to_char(first_sales_date_sk), 'YYYYMMDD'),
        current_date()
    ) as customer_tenure_years,

    case
        when datediff(year, to_date(to_char(first_sales_date_sk), 'YYYYMMDD'), current_date()) = 0 then true
        else false
    end as is_new_customer

from RETAILCO_DEV.RAW.customer
  )
