create or replace   view RETAILCO_DEV.RAW.int_customer_enriched
  
  
  
  
  as (
    

with customer as (
    select * from RETAILCO_DEV.staging.stg_customer
),

address as (
    select * from RETAILCO_DEV.staging.stg_customer_address
),

demo as (
    select * from RETAILCO_DEV.staging.stg_customer_demografics
),

household as (
    select * from RETAILCO_DEV.staging.stg_household_demographics
)

select
    -- Identificadores
    c.customer,
    c.customer_id,

    -- Datos personales
    c.salutation,
    c.first_name,
    c.last_name,
    c.preferred_cust_flag,
    c.birth_date,
    c.customer_age,
    c.birth_country,
    c.email_address,
    c.login,

    -- Dirección actual
    a.address_id,
    a.street_number,
    a.street_name,
    a.street_type,
    a.suite_number,
    a.city,
    a.county,
    a.state,
    a.zip_code,
    a.country,
    a.location_type,
    a.full_street_address,

    -- Demografía individual
    d.gender,
    d.marital_status,
    d.education_status,
    d.purchase_estimate,
    d.credit_rating,
    d.dependent_count as individual_dependent_count,
    d.dependent_employed_count,
    d.dependent_college_count,
    d.has_dependents as individual_has_dependents,

    -- Demografía del hogar
    h.income_band_sk,
    h.buy_potential,
    h.dependent_count as household_dependent_count,
    h.vehicle_count,
    h.has_vehicle,
    h.has_dependents as household_has_dependents,

    -- Derivadas útiles
    concat_ws(' ', c.first_name, c.last_name) as full_name,
    case when c.customer_age >= 18 then true else false end as is_adult,
    case
        when c.customer_age < 18 then 'minor'
        when c.customer_age between 18 and 34 then 'young_adult'
        when c.customer_age between 35 and 54 then 'adult'
        else 'senior'
    end as age_group,
    split_part(c.email_address, '@', 2) as email_domain

from customer as c
left join address a
    on c.current_addr_sk = a.address_sk
left join demo d
    on c.current_cdemo_sk = d.demo_sk
left join household h
    on c.current_hdemo_sk = h.household_demo_sk
  )
