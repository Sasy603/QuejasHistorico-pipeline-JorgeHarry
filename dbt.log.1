create or replace transient  table RETAILCO_DEV.RAW.int_unified_sales
    
    
    
    as (

with store as (
    select
        'store' as sales_channel,

        sold_date_sk,
        sold_time_sk,
        null as ship_date_sk, -- store_sales no tiene ship_date

        item_sk,

        -- Cliente facturado y receptor son el mismo en tienda
        customer_sk as bill_customer_sk,
        customer_demo_sk as bill_customer_demo_sk,
        household_demo_sk as bill_household_demo_sk,
        address_sk as bill_address_sk,

        customer_sk as ship_customer_sk,
        customer_demo_sk as ship_customer_demo_sk,
        household_demo_sk as ship_household_demo_sk,
        address_sk as ship_address_sk,

        store_sk,
        null as call_center_sk,
        null as catalog_page_sk,
        null as web_page_sk,
        null as web_site_sk,
        promo_sk,
        null as ship_mode_sk,
        null as warehouse_sk,

        ticket_number as order_number,

        quantity,
        wholesale_cost,
        list_price,
        sales_price,
        ext_discount_amount,
        ext_sales_price,
        ext_wholesale_cost,
        ext_list_price,
        ext_tax,
        coupon_amount,
        null as ext_shipping_cost,

        net_paid,
        net_paid_incl_tax,
        null as net_paid_incl_shipping,
        null as net_paid_incl_shipping_tax,

        net_profit
    from RETAILCO_DEV.STAGING.STG_STORE_SALES
),

catalog as (
    select
        'catalog' as sales_channel,

        sold_date_sk,
        sold_time_sk,
        ship_date_sk,

        item_sk,

        bill_customer_sk,
        bill_customer_demo_sk,
        bill_household_demo_sk,
        bill_address_sk,

        ship_customer_sk,
        ship_customer_demo_sk,
        ship_household_demo_sk,
        ship_address_sk,

        null as store_sk,
        call_center_sk,
        catalog_page_sk,
        null as web_page_sk,
        null as web_site_sk,
        promo_sk,
        ship_mode_sk,
        warehouse_sk,

        order_number,

        quantity,
        wholesale_cost,
        list_price,
        sales_price,
        ext_discount_amount,
        ext_sales_price,
        ext_wholesale_cost,
        ext_list_price,
        ext_tax,
        coupon_amount,
        ext_shipping_cost,

        net_paid,
        net_paid_incl_tax,
        net_paid_incl_shipping,
        net_paid_incl_shipping_tax,

        net_profit
    from RETAILCO_DEV.STAGING.STG_CATALOG_SALES
),

web as (
    select
        'web' as sales_channel,

        sold_date_sk,
        sold_time_sk,
        ship_date_sk,

        item_sk,

        bill_customer_sk,
        bill_customer_demo_sk,
        bill_household_demo_sk,
        bill_address_sk,

        ship_customer_sk,
        ship_customer_demo_sk,
        ship_household_demo_sk,
        ship_address_sk,

        null as store_sk,
        null as call_center_sk,
        null as catalog_page_sk,
        web_page_sk,
        web_site_sk,
        promo_sk,
        ship_mode_sk,
        warehouse_sk,

        order_number,

        quantity,
        wholesale_cost,
        list_price,
        sales_price,
        ext_discount_amount,
        ext_sales_price,
        ext_wholesale_cost,
        ext_list_price,
        ext_tax,
        coupon_amount,
        ext_shipping_cost,

        net_paid,
        net_paid_incl_tax,
        net_paid_incl_shipping,
        net_paid_incl_shipping_tax,

        net_profit
    from RETAILCO_DEV.STAGING.STG_WEB_SALES
)

select *
from (
    select * from store
    union all
    select * from catalog
    union all
    select * from web
) as unified_sales
    )

