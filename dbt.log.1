15:37:17.104899 [debug]: Query executed on node model.jaffle_shop.marts_sales_by_channel:
create or replace   view RETAILCO_DEV.MARTS.MARTS_SALES_BY_CHANNEL
  
  
  
  
  as (
    

WITH sales AS (

    SELECT *
    FROM RETAILCO_DEV.RAW.int_unified_sales
),

joined AS (
    SELECT
        s.sales_channel,

        -- Fecha
        d.year,
        d.month_of_year AS month,

        -- Categoría del producto
        i.category_name AS product_category,

        -- Ubicación según canal
        COALESCE(
            st.store_name,
            ws.site_name,
            CAST(cp.catalog_page_id AS VARCHAR)
        ) AS location_name,

        -- Métricas
        s.ext_sales_price,
        s.quantity,
        s.net_profit,
        s.net_paid


    FROM sales s

    LEFT JOIN RETAILCO_DEV.STAGING.STG_DATE_DIM d
        ON s.sold_date_sk = d.date_sk

    LEFT JOIN RETAILCO_DEV.STAGING.STG_ITEM i
        ON s.item_sk = i.item_sk

    LEFT JOIN RETAILCO_DEV.STAGING.STG_STORE st
        ON s.store_sk = st.store_sk

    LEFT JOIN RETAILCO_DEV.STAGING.STG_WEB_SITE ws
        ON s.web_site_sk = ws.web_site_sk

    LEFT JOIN RETAILCO_DEV.STAGING.STG_CATALOG_PAGE cp
        ON s.catalog_page_sk = cp.catalog_page_sk
)

SELECT
    sales_channel,
    location_name,
    year,
    month,
    product_category,
    SUM(ext_sales_price) AS total_sales_amount,
    SUM(quantity)        AS total_units,
    SUM(net_profit)      AS total_profit,
    SUM(net_paid)        AS total_net_paid,
    COUNT(*) AS num_transactions
FROM joined
GROUP BY
    sales_channel,
    location_name,
    year,
    month,
    product_category
ORDER BY
    year,
    month,
    sales_channel,
    location_name,
    product_category
