11:19:21.551931 [debug]: Query executed on node model.jaffle_shop.stg_store_sales:
create or replace   view RETAILCO_DEV.staging.stg_store_sales
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de ventas en tienda (store_sales)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (ss_ → sales_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis de ventas, márgenes y descuentos.
*/

select
    -- Fechas y tiempos
    COALESCE(ss_sold_date_sk::INTEGER, -1) as sold_date_sk,
    COALESCE(ss_sold_time_sk::INTEGER, -1) as sold_time_sk,

    -- Item
    COALESCE(ss_item_sk::INTEGER, -1) as item_sk,

    -- Cliente
    COALESCE(ss_customer_sk::INTEGER, -1) as customer_sk,
    COALESCE(ss_cdemo_sk::INTEGER, -1) as customer_demo_sk,
    COALESCE(ss_hdemo_sk::INTEGER, -1) as household_demo_sk,
    COALESCE(ss_addr_sk::INTEGER, -1) as address_sk,

    -- Tienda y promoción
    COALESCE(ss_store_sk::INTEGER, -1) as store_sk,
    COALESCE(ss_promo_sk::INTEGER, -1) as promo_sk,

    -- Ticket
    COALESCE(ss_ticket_number::INTEGER, -1) as ticket_number,

    -- Métricas de venta
    COALESCE(ss_quantity::INTEGER, 0) as quantity,
    COALESCE(ss_wholesale_cost::FLOAT, 0.0) as wholesale_cost,
    COALESCE(ss_list_price::FLOAT, 0.0) as list_price,
    COALESCE(ss_sales_price::FLOAT, 0.0) as sales_price,

    -- Extensiones (cantidad * precio)
    COALESCE(ss_ext_discount_amt::FLOAT, 0.0) as ext_discount_amount,
    COALESCE(ss_ext_sales_price::FLOAT, 0.0) as ext_sales_price,
    COALESCE(ss_ext_wholesale_cost::FLOAT, 0.0) as ext_wholesale_cost,
    COALESCE(ss_ext_list_price::FLOAT, 0.0) as ext_list_price,
    COALESCE(ss_ext_tax::FLOAT, 0.0) as ext_tax,
    COALESCE(ss_coupon_amt::FLOAT, 0.0) as coupon_amount,

    -- Pagos netos
    COALESCE(ss_net_paid::FLOAT, 0.0) as net_paid,
    COALESCE(ss_net_paid_inc_tax::FLOAT, 0.0) as net_paid_incl_tax,

    -- Margen
    COALESCE(ss_net_profit::FLOAT, 0.0) as net_profit

from RETAILCO_DEV.RAW.store_sales
  )
