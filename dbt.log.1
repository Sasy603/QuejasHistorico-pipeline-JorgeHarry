create or replace   view RETAILCO_DEV.staging.stg_web_returns
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de devoluciones web (web_returns)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (wr_ → return_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis de devoluciones, reembolsos y pérdidas.
*/

select
    -- Fechas y tiempos
    COALESCE(wr_returned_date_sk::INTEGER, -1) as returned_date_sk,
    COALESCE(wr_returned_time_sk::INTEGER, -1) as returned_time_sk,

    -- Item
    COALESCE(wr_item_sk::INTEGER, -1) as item_sk,

    -- Cliente que recibe el reembolso
    COALESCE(wr_refunded_customer_sk::INTEGER, -1) as refunded_customer_sk,
    COALESCE(wr_refunded_cdemo_sk::INTEGER, -1) as refunded_customer_demo_sk,
    COALESCE(wr_refunded_hdemo_sk::INTEGER, -1) as refunded_household_demo_sk,
    COALESCE(wr_refunded_addr_sk::INTEGER, -1) as refunded_address_sk,

    -- Cliente que realiza la devolución
    COALESCE(wr_returning_customer_sk::INTEGER, -1) as returning_customer_sk,
    COALESCE(wr_returning_cdemo_sk::INTEGER, -1) as returning_customer_demo_sk,
    COALESCE(wr_returning_hdemo_sk::INTEGER, -1) as returning_household_demo_sk,
    COALESCE(wr_returning_addr_sk::INTEGER, -1) as returning_address_sk,

    -- Página web y razón
    COALESCE(wr_web_page_sk::INTEGER, -1) as web_page_sk,
    COALESCE(wr_reason_sk::INTEGER, -1) as return_reason_sk,

    -- Orden
    COALESCE(wr_order_number::INTEGER, -1) as order_number,

    -- Métricas de devolución
    COALESCE(wr_return_quantity::INTEGER, 0) as return_quantity,
    COALESCE(wr_return_amt::FLOAT, 0.0) as return_amount,
    COALESCE(wr_return_tax::FLOAT, 0.0) as return_tax,
    COALESCE(wr_return_amt_inc_tax::FLOAT, 0.0) as return_amount_incl_tax,
    COALESCE(wr_fee::FLOAT, 0.0) as return_fee,
    COALESCE(wr_return_ship_cost::FLOAT, 0.0) as return_shipping_cost,

    -- Reembolsos
    COALESCE(wr_refunded_cash::FLOAT, 0.0) as refunded_cash,
    COALESCE(wr_reversed_charge::FLOAT, 0.0) as reversed_charge,
    COALESCE(wr_account_credit::FLOAT, 0.0) as account_credit,

    -- Pérdida neta
    COALESCE(wr_net_loss::FLOAT, 0.0) as net_loss

from RETAILCO_DEV.RAW.web_returns
  )
