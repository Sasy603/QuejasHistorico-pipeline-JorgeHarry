create or replace   view RETAILCO_DEV.staging.stg_customer_address
  
  
  
  
  as (
    

-- Modelo de staging para customer_address
-- Objetivo:
--  - Renombrar columnas eliminando prefijos crípticos
--  - Castear surrogate keys a tipos consistentes
--  - Limpiar NULLs según reglas del proyecto
--  - Crear columnas derivadas útiles en el layer de staging

select
    -- Surrogate keys
    COALESCE(ca_address_sk::INTEGER, -1)          as address_sk,
    COALESCE(ca_address_id::VARCHAR, 'UNKNOWN')   as address_id,

    -- Componentes de dirección
    COALESCE(NULLIF(TRIM(ca_street_number), ''), 'UNKNOWN') as street_number,
    COALESCE(NULLIF(TRIM(ca_street_name), ''), 'UNKNOWN')   as street_name,
    COALESCE(NULLIF(TRIM(ca_street_type), ''), 'UNKNOWN')   as street_type,
    COALESCE(NULLIF(TRIM(ca_suite_number), ''), 'UNKNOWN')  as suite_number,

    COALESCE(NULLIF(TRIM(ca_city), ''), 'UNKNOWN')   as city,
    COALESCE(NULLIF(TRIM(ca_county), ''), 'UNKNOWN') as county,
    COALESCE(NULLIF(TRIM(ca_state), ''), 'UNKNOWN')  as state,
    COALESCE(NULLIF(TRIM(ca_zip), ''), 'UNKNOWN')    as zip_code,
    COALESCE(NULLIF(TRIM(ca_country), ''), 'UNKNOWN') as country,

    -- Offset horario
    COALESCE(ca_gmt_offset::FLOAT, 0.0) as gmt_offset,

    -- Tipo de localización
    COALESCE(NULLIF(TRIM(ca_location_type), ''), 'UNKNOWN') as location_type,

    -- Columna derivada: dirección completa
    CONCAT_WS(
        ' ',
        NULLIF(TRIM(ca_street_number), ''),
        NULLIF(TRIM(ca_street_name), ''),
        NULLIF(TRIM(ca_street_type), ''),
        NULLIF(TRIM(ca_suite_number), '')
    ) as full_street_address

from RETAILCO_DEV.RAW.customer_address
  )
