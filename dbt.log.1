15:49:51.948236 [debug]: Query executed on node model.jaffle_shop.marts_sales_by_channel:
create or replace  temporary view RETAILCO_DEV.MARTS.marts_sales_by_channel__dbt_tmp
  
  
  
  
  as (
    

with base_sales as (

    -- STORE SALES
    select
        'STORE' as channel,
        store_sk,
        null as web_site_sk,
        null as catalog_page_sk,
        item_sk,
        sold_date_sk as date_sk,
        quantity,
        sales_price,
        ext_sales_price as gross_revenue,
        ext_discount_amount as discount_amount,
        ext_wholesale_cost as wholesale_cost,
        ext_list_price as list_price,
        ext_tax as tax_amount,
        0 as shipping_amount,
        0 as return_amount,
        0 as return_qty
    from RETAILCO_DEV.staging.stg_store_sales

    union all

    -- WEB SALES
    select
        'WEB' as channel,
        null as store_sk,
        web_site_sk,
        null as catalog_page_sk,
        item_sk,
        sold_date_sk as date_sk,
        quantity,
        sales_price,
        ext_sales_price as gross_revenue,
        ext_discount_amount as discount_amount,
        ext_wholesale_cost as wholesale_cost,
        ext_list_price as list_price,
        ext_tax as tax_amount,
        ext_shipping_cost as shipping_amount,
        0 as return_amount,
        0 as return_qty
    from RETAILCO_DEV.staging.stg_web_sales

    union all

    -- CATALOG SALES
    select
        'CATALOG' as channel,
        null as store_sk,
        null as web_site_sk,
        catalog_page_sk,
        item_sk,
        sold_date_sk as date_sk,
        quantity,
        sales_price,
        ext_sales_price as gross_revenue,
        ext_discount_amount as discount_amount,
        ext_wholesale_cost as wholesale_cost,
        ext_list_price as list_price,
        ext_tax as tax_amount,
        ext_shipping_cost as shipping_amount,
        0 as return_amount,
        0 as return_qty
    from RETAILCO_DEV.staging.stg_catalog_sales

),

-- 📌 DEVOLUCIONES WEB
web_returns as (
    select
        item_sk,
        returned_date_sk as date_sk,
        return_quantity,
        return_amount
    from RETAILCO_DEV.staging.stg_web_returns
),

-- 📌 DEVOLUCIONES AGREGADAS POR ITEM + FECHA
returns_agg as (
    select
        item_sk,
        date_sk,
        sum(return_quantity) as total_return_qty,
        sum(return_amount) as total_return_amount
    from web_returns
    group by 1,2
),

dim_date as (
    select
        date_sk,
        month_of_year as month
    from RETAILCO_DEV.staging.stg_date_dim
),

dim_item as (
    select
        item_sk,
        category_name as category
    from RETAILCO_DEV.staging.stg_item
),

joined as (
    select
        bs.channel,
        coalesce(bs.store_sk, bs.web_site_sk, bs.catalog_page_sk) as location_sk,
        di.category,
        dd.month,

        bs.quantity,
        bs.gross_revenue,
        bs.discount_amount,

        -- 📌 Si es WEB, reemplazamos con devoluciones reales
        coalesce(ra.total_return_amount, bs.return_amount) as return_amount,
        coalesce(ra.total_return_qty, bs.return_qty) as return_qty

    from base_sales bs
    left join dim_date dd on bs.date_sk = dd.date_sk
    left join dim_item di on bs.item_sk = di.item_sk
    left join returns_agg ra
        on bs.item_sk = ra.item_sk
       and bs.date_sk = ra.date_sk
       and bs.channel = 'WEB'
),

aggregated as (
    select
        channel,
        location_sk,
        category,
        month,

        sum(quantity) as units_sold,
        sum(gross_revenue) as gross_revenue,
        sum(discount_amount) as total_discount,
        sum(return_qty) as units_returned,
        sum(return_amount) as return_amount,

        case when sum(quantity) > 0
            then sum(return_qty)::float / sum(quantity)
            else 0 end as return_rate,

        sum(gross_revenue) - sum(return_amount) as net_revenue,

        case when sum(gross_revenue) > 0
            then sum(discount_amount)::float / sum(gross_revenue)
            else 0 end as avg_discount_pct
    from joined
    group by 1,2,3,4
)

select
    *,
    concat_ws('_', channel, location_sk, category, month) as channel_store_category_month_key
from aggregated


where month >= month(dateadd('day', -90, current_date))

  )
