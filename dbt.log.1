08:59:18.203524 [debug]: Query executed on node model.jaffle_shop.stg_customer:
create or replace   view RETAILCO_DEV.RAW.stg_customer
  
  
  
  
  as (
    

with source_customer as (

    select
        -- Surrogate keys casteados a BIGINT (o el tipo que use tu proyecto)
        cast(c_customer_sk as bigint)          as customer_sk,
        c_customer_id                          as customer_id,
        cast(c_current_cdemo_sk as bigint)     as current_customer_demo_sk,
        cast(c_current_hdemo_sk as bigint)     as current_household_demo_sk,
        cast(c_current_addr_sk as bigint)      as current_address_sk,

        -- Fechas
        cast(c_first_shipto_date_sk as bigint) as first_ship_date_sk,
        cast(c_first_sales_date_sk as bigint)  as first_sales_date_sk,

        -- Datos personales
        c_salutation                           as salutation,
        c_first_name                           as first_name,
        c_last_name                            as last_name,
        c_preferred_cust_flag                  as preferred_customer_flag,

        -- Fecha de nacimiento
        c_birth_day                             as birth_day,
        c_birth_month                           as birth_month,
        c_birth_year                            as birth_year,
        c_birth_country                         as birth_country,

        -- Contacto
        c_login                                 as login,
        c_email_address                         as email_address,

        -- Última revisión
        c_last_review_date                      as last_review_date

    from RETAILCO_DEV.RAW.customer

),

cleaned as (

    select
        *,
        -- Limpieza básica de NULLs según decisiones típicas de staging
        nullif(trim(first_name), '') as first_name_clean,
        nullif(trim(last_name), '')  as last_name_clean,
        nullif(trim(email_address), '') as email_address_clean,

        -- Derivada: fecha de nacimiento completa
        case
            when birth_year is not null
             and birth_month is not null
             and birth_day is not null
            then to_date(
                concat(birth_year, '-', birth_month, '-', birth_day)
            )
        end as birth_date

    from source_customer
),

final as (

    select
        *,
        -- Derivada: edad aproximada
        case
            when birth_year is not null
            then datediff('year', birth_date, current_date)
        end as customer_age

    from cleaned
)

select * from final
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.jaffle_shop.stg_customer", "profile_name": "jaffle_shop", "target_name": "dev"} */
