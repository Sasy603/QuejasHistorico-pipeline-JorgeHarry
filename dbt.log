    coalesce(cp_catalog_page_sk::integer, -1)          as catalog_page_sk,
    coalesce(cp_catalog_page_id, 'UNKNOWN')            as catalog_page_id,

    coalesce(cp_start_date_sk::integer, -1)            as start_date_sk,
