create or replace   view RETAILCO_DEV.staging.stg_catalog_sales
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de ventas por catálogo (catalog_sales)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (cs_ → sales_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis de ventas, márgenes y descuentos.
*/

select
    -- Fechas y tiempos
    COALESCE(cs_sold_date_sk::INTEGER, -1) as sold_date_sk,
    COALESCE(cs_sold_time_sk::INTEGER, -1) as sold_time_sk,
    COALESCE(cs_ship_date_sk::INTEGER, -1) as ship_date_sk,

    -- Cliente facturado
    COALESCE(cs_bill_customer_sk::INTEGER, -1) as bill_customer_sk,
    COALESCE(cs_bill_cdemo_sk::INTEGER, -1) as bill_customer_demo_sk,
    COALESCE(cs_bill_hdemo_sk::INTEGER, -1) as bill_household_demo_sk,
    COALESCE(cs_bill_addr_sk::INTEGER, -1) as bill_address_sk,

    -- Cliente receptor del envío
    COALESCE(cs_ship_customer_sk::INTEGER, -1) as ship_customer_sk,
    COALESCE(cs_ship_cdemo_sk::INTEGER, -1) as ship_customer_demo_sk,
    COALESCE(cs_ship_hdemo_sk::INTEGER, -1) as ship_household_demo_sk,
    COALESCE(cs_ship_addr_sk::INTEGER, -1) as ship_address_sk,

    -- Dimensiones relacionadas
    COALESCE(cs_call_center_sk::INTEGER, -1) as call_center_sk,
    COALESCE(cs_catalog_page_sk::INTEGER, -1) as catalog_page_sk,
    COALESCE(cs_ship_mode_sk::INTEGER, -1) as ship_mode_sk,
    COALESCE(cs_warehouse_sk::INTEGER, -1) as warehouse_sk,
    COALESCE(cs_item_sk::INTEGER, -1) as item_sk,
    COALESCE(cs_promo_sk::INTEGER, -1) as promo_sk,

    -- Orden
    COALESCE(cs_order_number::INTEGER, -1) as order_number,

    -- Métricas de venta
    COALESCE(cs_quantity::INTEGER, 0) as quantity,
    COALESCE(cs_wholesale_cost::FLOAT, 0.0) as wholesale_cost,
    COALESCE(cs_list_price::FLOAT, 0.0) as list_price,
    COALESCE(cs_sales_price::FLOAT, 0.0) as sales_price,

    -- Extensiones (cantidad * precio)
    COALESCE(cs_ext_discount_amt::FLOAT, 0.0) as ext_discount_amount,
    COALESCE(cs_ext_sales_price::FLOAT, 0.0) as ext_sales_price,
    COALESCE(cs_ext_wholesale_cost::FLOAT, 0.0) as ext_wholesale_cost,
    COALESCE(cs_ext_list_price::FLOAT, 0.0) as ext_list_price,
    COALESCE(cs_ext_tax::FLOAT, 0.0) as ext_tax,
    COALESCE(cs_coupon_amt::FLOAT, 0.0) as coupon_amount,
    COALESCE(cs_ext_ship_cost::FLOAT, 0.0) as ext_shipping_cost,

    -- Pagos netos
    COALESCE(cs_net_paid::FLOAT, 0.0) as net_paid,
    COALESCE(cs_net_paid_inc_tax::FLOAT, 0.0) as net_paid_incl_tax,
    COALESCE(cs_net_paid_inc_ship::FLOAT, 0.0) as net_paid_incl_shipping,
    COALESCE(cs_net_paid_inc_ship_tax::FLOAT, 0.0) as net_paid_incl_shipping_tax,

    -- Margen
    COALESCE(cs_net_profit::FLOAT, 0.0) as net_profit

from RETAILCO_DEV.RAW.catalog_sales
  )
