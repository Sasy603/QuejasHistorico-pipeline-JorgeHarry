        warehouse_sk,

        order_number,

        quantity,
        wholesale_cost,
        list_price,
        sales_price,
        ext_discount_amount,
        ext_sales_price,
        ext_wholesale_cost,
        ext_list_price,
        ext_tax,
        coupon_amount,
        ext_shipping_cost,

        net_paid,
        net_paid_incl_tax,
        net_paid_incl_shipping,
        net_paid_incl_shipping_tax,

        net_profit
    from RETAILCO_DEV.STAGING.STG_WEB_SALES
)

select *
from (
    select * from store
    union all
    select * from catalog
    union all
    select * from web
) as unified_sales
    )

