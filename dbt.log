create or replace   view RETAILCO_DEV.staging.stg_item
  
  
  
  
  as (
    

/*
    Este modelo estandariza la dimensión de productos (item)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (i_ → item_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Derivación de columna is_current para SCD Type 2.
*/

select
    -- Surrogate keys
    COALESCE(i_item_sk::INTEGER, -1) as item_sk,
    COALESCE(i_item_id::VARCHAR, 'UNKNOWN') as item_id,

    -- Fechas SCD2
    COALESCE(i_rec_start_date::DATE, DATE '1900-01-01') as record_start_date,
    COALESCE(i_rec_end_date::DATE, DATE '9999-12-31') as record_end_date,

    -- Atributos del producto
    COALESCE(NULLIF(TRIM(i_item_desc), ''), 'UNKNOWN') as item_description,
    COALESCE(i_current_price::FLOAT, 0.0) as current_price,
    COALESCE(i_wholesale_cost::FLOAT, 0.0) as wholesale_cost,

    -- Marca
    COALESCE(i_brand_id::INTEGER, -1) as brand_id,
    COALESCE(NULLIF(TRIM(i_brand), ''), 'UNKNOWN') as brand_name,

    -- Clase
    COALESCE(i_class_id::INTEGER, -1) as class_id,
    COALESCE(NULLIF(TRIM(i_class), ''), 'UNKNOWN') as class_name,

    -- Categoría
    COALESCE(i_category_id::INTEGER, -1) as category_id,
    COALESCE(NULLIF(TRIM(i_category), ''), 'UNKNOWN') as category_name,

    -- Fabricante
    COALESCE(i_manufact_id::INTEGER, -1) as manufacturer_id,
    COALESCE(NULLIF(TRIM(i_manufact), ''), 'UNKNOWN') as manufacturer_name,

    -- Atributos físicos
    COALESCE(NULLIF(TRIM(i_size), ''), 'UNKNOWN') as size,
    COALESCE(NULLIF(TRIM(i_formulation), ''), 'UNKNOWN') as formulation,
    COALESCE(NULLIF(TRIM(i_color), ''), 'UNKNOWN') as color,
    COALESCE(NULLIF(TRIM(i_units), ''), 'UNKNOWN') as units,
    COALESCE(NULLIF(TRIM(i_container), ''), 'UNKNOWN') as container,

    -- Manager responsable del producto
    COALESCE(i_manager_id::INTEGER, -1) as manager_id,

    -- Nombre del producto
    COALESCE(NULLIF(TRIM(i_product_name), ''), 'UNKNOWN') as product_name,

    -- Columna derivada: registro vigente (SCD2)
    case 
        when i_rec_end_date is null or i_rec_end_date = DATE '9999-12-31'
        then true
        else false
    end as is_current

from RETAILCO_DEV.RAW.item
  )
