        item_sk,

        bill_customer_sk,
        bill_customer_demo_sk,
        bill_household_demo_sk,
        bill_address_sk,

        ship_customer_sk,
        ship_customer_demo_sk,
        ship_household_demo_sk,
        ship_address_sk,

        null as store_sk,
        call_center_sk,
        catalog_page_sk,
        null as web_page_sk,
        null as web_site_sk,
        promo_sk,
        ship_mode_sk,
        warehouse_sk,

        order_number,

        quantity,
        wholesale_cost,
        list_price,
        sales_price,
        ext_discount_amount,
        ext_sales_price,
        ext_wholesale_cost,
        ext_list_price,
