create or replace   view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_catalog_returns
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de devoluciones de catálogo (catalog_returns)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (cr_ → return_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis de devoluciones y pérdidas.
*/

select
    -- Fechas y tiempos
    COALESCE(cr_returned_date_sk::INTEGER, -1) as returned_date_sk,
    COALESCE(cr_returned_time_sk::INTEGER, -1) as returned_time_sk,

    -- Item y orden
    COALESCE(cr_item_sk::INTEGER, -1) as item_sk,
    COALESCE(cr_order_number::INTEGER, -1) as order_number,

    -- Información del cliente que recibe el reembolso
    COALESCE(cr_refunded_customer_sk::INTEGER, -1) as refunded_customer_sk,
    COALESCE(cr_refunded_cdemo_sk::INTEGER, -1) as refunded_customer_demo_sk,
    COALESCE(cr_refunded_hdemo_sk::INTEGER, -1) as refunded_household_demo_sk,
    COALESCE(cr_refunded_addr_sk::INTEGER, -1) as refunded_address_sk,

    -- Información del cliente que realiza la devolución
    COALESCE(cr_returning_customer_sk::INTEGER, -1) as returning_customer_sk,
    COALESCE(cr_returning_cdemo_sk::INTEGER, -1) as returning_customer_demo_sk,
    COALESCE(cr_returning_hdemo_sk::INTEGER, -1) as returning_household_demo_sk,
    COALESCE(cr_returning_addr_sk::INTEGER, -1) as returning_address_sk,

    -- Dimensiones relacionadas
    COALESCE(cr_call_center_sk::INTEGER, -1) as call_center_sk,
    COALESCE(cr_catalog_page_sk::INTEGER, -1) as catalog_page_sk,
    COALESCE(cr_ship_mode_sk::INTEGER, -1) as ship_mode_sk,
    COALESCE(cr_warehouse_sk::INTEGER, -1) as warehouse_sk,
    COALESCE(cr_reason_sk::INTEGER, -1) as return_reason_sk,

    -- Métricas de la devolución
    COALESCE(cr_return_quantity::INTEGER, 0) as return_quantity,
    COALESCE(cr_return_amount::FLOAT, 0.0) as return_amount,
    COALESCE(cr_return_tax::FLOAT, 0.0) as return_tax,
    COALESCE(cr_return_amt_inc_tax::FLOAT, 0.0) as return_amount_incl_tax,
    COALESCE(cr_fee::FLOAT, 0.0) as return_fee,
    COALESCE(cr_return_ship_cost::FLOAT, 0.0) as return_shipping_cost,

    -- Reembolsos
    COALESCE(cr_refunded_cash::FLOAT, 0.0) as refunded_cash,
    COALESCE(cr_reversed_charge::FLOAT, 0.0) as reversed_charge,
    COALESCE(cr_store_credit::FLOAT, 0.0) as store_credit,

    -- Pérdida neta
    COALESCE(cr_net_loss::FLOAT, 0.0) as net_loss

from RETAILCO_DEV.RAW.catalog_returns
  )
