create or replace   view RETAILCO_DEV.staging.stg_customer_demografics
  
  
  
  
  as (
    

select
    -- Surrogate key
    COALESCE(cd_demo_sk::INTEGER, -1) as demo_sk,

    -- Atributos demográficos
    COALESCE(NULLIF(TRIM(cd_gender), ''), 'UNKNOWN')            as gender,
    COALESCE(NULLIF(TRIM(cd_marital_status), ''), 'UNKNOWN')   as marital_status,
    COALESCE(NULLIF(TRIM(cd_education_status), ''), 'UNKNOWN') as education_status,

    -- Estimaciones y ratings
    COALESCE(cd_purchase_estimate::INTEGER, 0) as purchase_estimate,
    COALESCE(NULLIF(TRIM(cd_credit_rating), ''), 'UNKNOWN')     as credit_rating,

    -- Dependientes
    COALESCE(cd_dep_count::INTEGER, 0)            as dependent_count,
    COALESCE(cd_dep_employed_count::INTEGER, 0)   as dependent_employed_count,
    COALESCE(cd_dep_college_count::INTEGER, 0)    as dependent_college_count,

    -- Columna derivada: tiene dependientes?
    CASE WHEN cd_dep_count > 0 THEN TRUE ELSE FALSE END as has_dependents

from RETAILCO_DEV.RAW.customer_demographics
  )
