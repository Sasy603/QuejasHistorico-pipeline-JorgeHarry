create or replace   view RETAILCO_DEV.staging.stg_household_demographics
  
  
  
  
  as (
    

select
    -- Surrogate key
    COALESCE(hd_demo_sk::INTEGER, -1) as household_demo_sk,

    -- Foreign key a income_band
    COALESCE(hd_income_band_sk::INTEGER, -1) as income_band_sk,

    -- Atributos del hogar
    COALESCE(NULLIF(TRIM(hd_buy_potential), ''), 'UNKNOWN') as buy_potential,
    COALESCE(hd_dep_count::INTEGER, 0)                     as dependent_count,
    COALESCE(hd_vehicle_count::INTEGER, 0)                 as vehicle_count,

    -- Columna derivada: ¿tiene vehículos?
    CASE WHEN hd_vehicle_count > 0 THEN TRUE ELSE FALSE END as has_vehicle,

    -- Columna derivada: ¿hogar con dependientes?
    CASE WHEN hd_dep_count > 0 THEN TRUE ELSE FALSE END as has_dependents

from RETAILCO_DEV.RAW.household_demographics
  )
