create or replace   view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_store_returns
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de devoluciones en tienda (store_returns)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (sr_ → return_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis de devoluciones, reembolsos y pérdidas.
*/

select
    -- Fechas y tiempos
    COALESCE(sr_returned_date_sk::INTEGER, -1) as returned_date_sk,
    COALESCE(sr_return_time_sk::INTEGER, -1) as returned_time_sk,

    -- Item
    COALESCE(sr_item_sk::INTEGER, -1) as item_sk,

    -- Cliente
    COALESCE(sr_customer_sk::INTEGER, -1) as customer_sk,
    COALESCE(sr_cdemo_sk::INTEGER, -1) as customer_demo_sk,
    COALESCE(sr_hdemo_sk::INTEGER, -1) as household_demo_sk,
    COALESCE(sr_addr_sk::INTEGER, -1) as address_sk,

    -- Tienda y razón
    COALESCE(sr_store_sk::INTEGER, -1) as store_sk,
    COALESCE(sr_reason_sk::INTEGER, -1) as return_reason_sk,

    -- Ticket
    COALESCE(sr_ticket_number::INTEGER, -1) as ticket_number,

    -- Métricas de devolución
    COALESCE(sr_return_quantity::INTEGER, 0) as return_quantity,
    COALESCE(sr_return_amt::FLOAT, 0.0) as return_amount,
    COALESCE(sr_return_tax::FLOAT, 0.0) as return_tax,
    COALESCE(sr_return_amt_inc_tax::FLOAT, 0.0) as return_amount_incl_tax,
    COALESCE(sr_fee::FLOAT, 0.0) as return_fee,
    COALESCE(sr_return_ship_cost::FLOAT, 0.0) as return_shipping_cost,

    -- Reembolsos
    COALESCE(sr_refunded_cash::FLOAT, 0.0) as refunded_cash,
    COALESCE(sr_reversed_charge::FLOAT, 0.0) as reversed_charge,
    COALESCE(sr_store_credit::FLOAT, 0.0) as store_credit,

    -- Pérdida neta
    COALESCE(sr_net_loss::FLOAT, 0.0) as net_loss

from RETAILCO_DEV.RAW.store_returns
  )
