create or replace transient  table QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.MARTS.marts_sales_by_channel
    
    
    
    as (

with base_sales as (

    -- STORE SALES
    select
        'STORE' as channel,
        store_sk,
        null as web_site_sk,
        null as catalog_page_sk,
        item_sk,
        sold_date_sk as date_sk,
        quantity,
        sales_price,
        ext_sales_price as gross_revenue,
        ext_discount_amount as discount_amount,
        ext_wholesale_cost as wholesale_cost,
        ext_list_price as list_price,
        ext_tax as tax_amount,
        0 as shipping_amount,          
        0 as return_amount,            
        0 as return_qty
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_store_sales

    union all

    -- WEB SALES
    select
        'WEB' as channel,
        null as store_sk,
        web_site_sk,
        null as catalog_page_sk,
        item_sk,
        sold_date_sk as date_sk,
        quantity,
        sales_price,
        ext_sales_price as gross_revenue,
        ext_discount_amount as discount_amount,
        ext_wholesale_cost as wholesale_cost,
        ext_list_price as list_price,
        ext_tax as tax_amount,
        ext_shipping_cost as shipping_amount,
        0 as return_amount,
        0 as return_qty
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_web_sales

    union all

    -- CATALOG SALES
    select
        'CATALOG' as channel,
        null as store_sk,
        null as web_site_sk,
        catalog_page_sk,
        item_sk,
        sold_date_sk as date_sk,
        quantity,
        sales_price,
        ext_sales_price as gross_revenue,
        ext_discount_amount as discount_amount,
        ext_wholesale_cost as wholesale_cost,
        ext_list_price as list_price,
        ext_tax as tax_amount,
        ext_shipping_cost as shipping_amount,
        0 as return_amount,
        0 as return_qty
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_catalog_sales
),

-- NUEVO: DEVOLUCIONES
base_returns as (

    -- STORE RETURNS
    select
        'STORE' as channel,
        store_sk,
        null as web_site_sk,
        null as catalog_page_sk,
        item_sk,
        returned_date_sk as date_sk,
        return_quantity as return_qty,
        return_amount,
        return_tax as return_tax
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_store_returns

    union all

    -- WEB RETURNS
    select
        'WEB' as channel,
        null as store_sk,
        web_page_sk as web_site_sk,
        null as catalog_page_sk,
        item_sk,
        returned_date_sk as date_sk,
        return_quantity as return_qty,
        return_amount,
        return_tax
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_web_returns

    union all

    -- CATALOG RETURNS
    select
        'CATALOG' as channel,
        null as store_sk,
        null as web_site_sk,
        catalog_page_sk,
        item_sk,
        returned_date_sk as date_sk,
        return_quantity as return_qty,
        return_amount,
        return_tax
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_catalog_returns
),

dim_date as (
    select
        date_sk,
        month_of_year as month
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_date_dim
),

dim_item as (
    select
        item_sk,
        category_name as category
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_item
),

-- UNIFICAMOS VENTAS Y DEVOLUCIONES
joined as (
    select
        bs.channel,
        coalesce(bs.store_sk, bs.web_site_sk, bs.catalog_page_sk) as location_sk,
        di.category,
        dd.month,

        bs.quantity,
        bs.gross_revenue,
        bs.discount_amount,
        bs.shipping_amount,

        coalesce(br.return_qty, 0) as return_qty,
        coalesce(br.return_amount, 0) as return_amount

    from base_sales bs
    left join base_returns br
        on bs.channel = br.channel
        and bs.item_sk = br.item_sk
        and bs.date_sk = br.date_sk
        and coalesce(bs.store_sk, bs.web_site_sk, bs.catalog_page_sk)
            = coalesce(br.store_sk, br.web_site_sk, br.catalog_page_sk)
    left join dim_date dd on bs.date_sk = dd.date_sk
    left join dim_item di on bs.item_sk = di.item_sk
),

aggregated as (
    select
        channel,
        location_sk,
        category,
        month,

        sum(quantity) as units_sold,
        sum(gross_revenue) as gross_revenue,
        sum(discount_amount) as total_discount,
        sum(return_qty) as units_returned,
        sum(return_amount) as return_amount,

        case when sum(quantity) > 0
            then sum(return_qty)::float / sum(quantity)
            else 0 end as return_rate,

        sum(gross_revenue) - sum(return_amount) as net_revenue,

        case when sum(gross_revenue) > 0
            then sum(discount_amount)::float / sum(gross_revenue)
            else 0 end as avg_discount_pct
    from joined
    group by 1,2,3,4
)

select
    *,
    concat_ws('_', channel, location_sk, category, month) as channel_store_category_month_key
from aggregated


    )

