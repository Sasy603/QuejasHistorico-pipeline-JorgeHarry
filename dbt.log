create or replace   view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_store
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de tiendas (store) proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (s_ → store_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Derivación de columnas útiles para staging:
        * is_current → indica si el registro está vigente (SCD Type 2).
*/

select
    -- Surrogate keys
    COALESCE(s_store_sk::INTEGER, -1) as store_sk,
    COALESCE(s_store_id::VARCHAR, 'UNKNOWN') as store_id,

    -- Fechas SCD
    COALESCE(s_rec_start_date::DATE, DATE '1900-01-01') as record_start_date,
    COALESCE(s_rec_end_date::DATE, DATE '9999-12-31') as record_end_date,
    COALESCE(s_closed_date_sk::INTEGER, -1) as closed_date_sk,

    -- Atributos principales
    COALESCE(NULLIF(TRIM(s_store_name), ''), 'UNKNOWN') as store_name,
    COALESCE(s_number_employees::INTEGER, 0) as number_employees,
    COALESCE(s_floor_space::INTEGER, 0) as floor_space,
    COALESCE(NULLIF(TRIM(s_hours), ''), 'UNKNOWN') as opening_hours,
    COALESCE(NULLIF(TRIM(s_manager), ''), 'UNKNOWN') as manager_name,

    -- Market info
    COALESCE(s_market_id::INTEGER, -1) as market_id,
    COALESCE(NULLIF(TRIM(s_geography_class), ''), 'UNKNOWN') as geography_class,
    COALESCE(NULLIF(TRIM(s_market_desc), ''), 'UNKNOWN') as market_description,
    COALESCE(NULLIF(TRIM(s_market_manager), ''), 'UNKNOWN') as market_manager,

    -- Company info
    COALESCE(s_division_id::INTEGER, -1) as division_id,
    COALESCE(NULLIF(TRIM(s_division_name), ''), 'UNKNOWN') as division_name,
    COALESCE(s_company_id::INTEGER, -1) as company_id,
    COALESCE(NULLIF(TRIM(s_company_name), ''), 'UNKNOWN') as company_name,

    -- Dirección
    COALESCE(NULLIF(TRIM(s_street_number), ''), 'UNKNOWN') as street_number,
    COALESCE(NULLIF(TRIM(s_street_name), ''), 'UNKNOWN') as street_name,
    COALESCE(NULLIF(TRIM(s_street_type), ''), 'UNKNOWN') as street_type,
    COALESCE(NULLIF(TRIM(s_suite_number), ''), 'UNKNOWN') as suite_number,
    COALESCE(NULLIF(TRIM(s_city), ''), 'UNKNOWN') as city,
    COALESCE(NULLIF(TRIM(s_county), ''), 'UNKNOWN') as county,
    COALESCE(NULLIF(TRIM(s_state), ''), 'UNKNOWN') as state,
    COALESCE(NULLIF(TRIM(s_zip), ''), 'UNKNOWN') as zip_code,
    COALESCE(NULLIF(TRIM(s_country), ''), 'UNKNOWN') as country,

    -- Zona horaria
    COALESCE(s_gmt_offset::FLOAT, 0.0) as gmt_offset,

    -- Columna derivada: registro vigente (SCD2)
    case 
        when s_rec_end_date is null or s_rec_end_date = DATE '9999-12-31'
        then true
        else false
    end as is_current

from RETAILCO_DEV.RAW.store
  )
