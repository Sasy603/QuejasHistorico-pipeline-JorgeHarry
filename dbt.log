10:07:04.449332 [debug]: Query executed on node model.jaffle_shop.stg_web_sales:
create or replace   view RETAILCO_DEV.staging.stg_web_sales
  
  
  
  
  as (
    

/*
    Este modelo estandariza la tabla de ventas web (web_sales)
    proveniente del raw layer.

    Transformaciones aplicadas:
    - Renombrado de columnas eliminando prefijos crípticos (ws_ → sales_).
    - Casteo consistente de surrogate keys a INTEGER.
    - Limpieza de NULLs y valores vacíos.
    - Preparación para análisis de ventas, márgenes y descuentos.
*/

select
    -- Fechas y tiempos
    COALESCE(ws_sold_date_sk::INTEGER, -1) as sold_date_sk,
    COALESCE(ws_sold_time_sk::INTEGER, -1) as sold_time_sk,
    COALESCE(ws_ship_date_sk::INTEGER, -1) as ship_date_sk,

    -- Item
    COALESCE(ws_item_sk::INTEGER, -1) as item_sk,

    -- Cliente facturado
    COALESCE(ws_bill_customer_sk::INTEGER, -1) as bill_customer_sk,
    COALESCE(ws_bill_cdemo_sk::INTEGER, -1) as bill_customer_demo_sk,
    COALESCE(ws_bill_hdemo_sk::INTEGER, -1) as bill_household_demo_sk,
    COALESCE(ws_bill_addr_sk::INTEGER, -1) as bill_address_sk,

    -- Cliente receptor del envío
    COALESCE(ws_ship_customer_sk::INTEGER, -1) as ship_customer_sk,
    COALESCE(ws_ship_cdemo_sk::INTEGER, -1) as ship_customer_demo_sk,
    COALESCE(ws_ship_hdemo_sk::INTEGER, -1) as ship_household_demo_sk,
    COALESCE(ws_ship_addr_sk::INTEGER, -1) as ship_address_sk,

    -- Página web, sitio y logística
    COALESCE(ws_web_page_sk::INTEGER, -1) as web_page_sk,
    COALESCE(ws_web_site_sk::INTEGER, -1) as web_site_sk,
    COALESCE(ws_ship_mode_sk::INTEGER, -1) as ship_mode_sk,
    COALESCE(ws_warehouse_sk::INTEGER, -1) as warehouse_sk,

    -- Promoción
    COALESCE(ws_promo_sk::INTEGER, -1) as promo_sk,

    -- Orden
    COALESCE(ws_order_number::INTEGER, -1) as order_number,

    -- Métricas de venta
    COALESCE(ws_quantity::INTEGER, 0) as quantity,
    COALESCE(ws_wholesale_cost::FLOAT, 0.0) as wholesale_cost,
    COALESCE(ws_list_price::FLOAT, 0.0) as list_price,
    COALESCE(ws_sales_price::FLOAT, 0.0) as sales_price,

    -- Extensiones (cantidad * precio)
    COALESCE(ws_ext_discount_amt::FLOAT, 0.0) as ext_discount_amount,
    COALESCE(ws_ext_sales_price::FLOAT, 0.0) as ext_sales_price,
    COALESCE(ws_ext_wholesale_cost::FLOAT, 0.0) as ext_wholesale_cost,
    COALESCE(ws_ext_list_price::FLOAT, 0.0) as ext_list_price,
    COALESCE(ws_ext_tax::FLOAT, 0.0) as ext_tax,
    COALESCE(ws_coupon_amt::FLOAT, 0.0) as coupon_amount,
    COALESCE(ws_ext_ship_cost::FLOAT, 0.0) as ext_shipping_cost,

    -- Pagos netos
    COALESCE(ws_net_paid::FLOAT, 0.0) as net_paid,
    COALESCE(ws_net_paid_inc_tax::FLOAT, 0.0) as net_paid_incl_tax,
    COALESCE(ws_net_paid_inc_ship::FLOAT, 0.0) as net_paid_incl_shipping,
    COALESCE(ws_net_paid_inc_ship_tax::FLOAT, 0.0) as net_paid_incl_shipping_tax,

    -- Margen
    COALESCE(ws_net_profit::FLOAT, 0.0) as net_profit

from RETAILCO_DEV.RAW.web_sales
  )
