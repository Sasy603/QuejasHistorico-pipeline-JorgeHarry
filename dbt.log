create or replace  temporary view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.MARTS.mart_customer_lifetime_value__dbt_tmp
  
  
  
  
  as (
    


/*mart_customer_lifetime_value con CLV por cliente, número de transacciones por
canal, primera y última compra, tasa de devolución, y un campo value_segment
(alto/medio/bajo) usando umbrales fijos basados en TPC‑DS Snowflake.*/

with unified_sales as (
    select * from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.RAW.int_unified_sales
),

unified_returns as (
    select * from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.RAW.int_unified_return
)

select
    -- Claves y dimensiones
    s.bill_customer_sk,
    s.bill_customer_demo_sk,
    s.bill_household_demo_sk,
    s.bill_address_sk,

    -- Métricas de ventas (CLV = total_revenue)
    sum(s.ext_sales_price) as total_revenue,
    count(distinct s.order_number) as total_transactions,
    min(s.sold_date_sk) as first_purchase_date_sk,
    max(s.sold_date_sk) as last_purchase_date_sk,

    -- Métricas de devoluciones
    sum(r.return_amount) as total_return_amount,
    count(distinct case when r.return_amount > 0 then s.order_number end) as return_transactions,

    -- Tasa de devolución
    case 
        when sum(s.ext_sales_price) > 0 
        then sum(r.return_amount) / sum(s.ext_sales_price)
        else 0 
    end as return_rate,

    -- Segmento de valor basado en umbrales fijos TPC‑DS
    case
        when sum(s.ext_sales_price) >= 5000 then 'alto'
        when sum(s.ext_sales_price) >= 1000 then 'medio'
        else 'bajo'
    end as value_segment

from unified_sales s
left join unified_returns r 
    on s.order_number = r.order_number
group by 1,2,3,4
  )
/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.jaffle_shop.mart_customer_lifetime_value", "profile_name": "jaffle_shop", "target_name": "dev"} */
14:52:01.608987 [debug]: Query executed on node model.jaffle_shop.mart_inventory_health:
create or replace   view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.MARTS.mart_inventory_health
  
  
  
  
  as (
    

with inv as (
    select
        item_sk,
        warehouse_sk,
        date_sk,
        quantity_on_hand
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_inventory
),

sales as (
    select
        item_sk,
        warehouse_sk,
        sold_date_sk,
        quantity
    from QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.RAW.int_unified_sales
),

-- Normalizamos fechas a semana
inv_weekly as (
    select
        item_sk,
        warehouse_sk,
        date_trunc('week', to_date(cast(date_sk as varchar))) as week_start,
        avg(quantity_on_hand) as avg_stock_week
    from inv
    group by 1,2,3
),

sales_weekly as (
    select
        item_sk,
        warehouse_sk,
        date_trunc('week', to_date(cast(sold_date_sk as varchar))) as week_start,
        sum(quantity) as weekly_sales
    from sales
    group by 1,2,3
),

combined as (
    select
        i.item_sk,
        i.warehouse_sk,
        i.week_start,
        i.avg_stock_week,
        coalesce(s.weekly_sales, 0) as weekly_sales
    from inv_weekly i
    left join sales_weekly s
        on i.item_sk = s.item_sk
        and i.warehouse_sk = s.warehouse_sk
        and i.week_start = s.week_start
),

-- Tendencia usando window functions
trend_calc as (
    select
        *,
        lag(avg_stock_week) over (
            partition by item_sk, warehouse_sk
            order by week_start
        ) as prev_stock
    from combined
)

select
    item_sk,
    warehouse_sk,

    -- Stock medio semanal
    avg(avg_stock_week) as stock_medio_semanal,

    -- Ventas semanales medias
    avg(weekly_sales) as ventas_semanales_medias,

    -- Semanas de stock
    case 
        when avg(weekly_sales) > 0 
        then avg(avg_stock_week) / avg(weekly_sales)
        else null
    end as semanas_de_stock,

    -- Semanas con rotura de stock
    sum(case when avg_stock_week = 0 then 1 else 0 end) as semanas_con_rotura_stock,

    -- Tendencia basada en variación del stock
    case
        when avg(avg_stock_week - prev_stock) > 5 then 'creciente'
        when avg(prev_stock - avg_stock_week) > 5 then 'decreciente'
        else 'estable'
    end as tendencia

from trend_calc
group by 1,2
  )
