create or replace transient  table QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.RAW.int_unified_return
    
    
    
    as (

with store as (
    select
        'store' as return_channel,

        returned_date_sk,
        returned_time_sk,
        null as received_date_sk,

        item_sk,

        customer_sk as return_customer_sk,
        customer_demo_sk as return_customer_demo_sk,
        household_demo_sk as return_household_demo_sk,
        address_sk as return_address_sk,

        store_sk,
        null as call_center_sk,
        null as catalog_page_sk,
        null as web_page_sk,
        null as web_site_sk,
        null as ship_mode_sk,
        null as warehouse_sk,

        ticket_number as order_number,

        return_quantity,
        return_amount,
        return_tax,
        return_fee,
        return_shipping_cost,
        refunded_cash,
        null as refund_incl_shipping,
        null as return_amount_incl_tax,

        return_amount - return_fee as net_loss
    from RETAILCO_DEV.STAGING.STG_STORE_RETURNS
),

catalog as (
    select

        'catalog' as return_channel,

        returned_date_sk,
        returned_time_sk,
        null as received_date_sk,

        item_sk,

        refunded_customer_sk,
        refunded_customer_demo_sk,
        refunded_household_demo_sk,
        refunded_address_sk,

        null as store_sk,
        call_center_sk,
        catalog_page_sk,
        null as web_page_sk,
        null as web_site_sk,
        ship_mode_sk,
        warehouse_sk,

        order_number,

        return_quantity,
        return_amount,
        return_tax,
        return_fee,
        return_shipping_cost,
        refunded_cash,
        null as refund_incl_shipping,
        return_amount_incl_tax,

        return_amount - return_fee as net_loss
    from RETAILCO_DEV.STAGING.STG_CATALOG_RETURNS
),

web as (
    select
        'web' as return_channel,

        returned_date_sk,
        returned_time_sk,
        null as received_date_sk,

        item_sk,

        refunded_customer_sk,
        refunded_customer_demo_sk,
        refunded_household_demo_sk,
        refunded_address_sk,

        null as store_sk,
        null as call_center_sk,
        null as catalog_page_sk,
        web_page_sk,
        null as web_site_sk,
        null as ship_mode_sk,
        null as warehouse_sk,

        order_number,

        return_quantity,
        return_amount,
        return_tax,
        null as return_fee,
        return_shipping_cost,
        refunded_cash,
        null as refund_incl_shipping,
        return_amount_incl_tax,

        return_amount as net_loss
    from RETAILCO_DEV.STAGING.STG_WEB_RETURNS
)

select *
from (
    select * from store
    union all
    select * from catalog
    union all
    select * from web
) as unified_returns
    )

