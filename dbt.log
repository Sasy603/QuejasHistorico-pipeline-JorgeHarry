09:29:04.814931 [debug]: Query executed on node model.jaffle_shop.mart_customer_lifetime_value:
create or replace transient  table RETAILCO_DEV.MARTS.mart_customer_lifetime_value
    
    
    
    as (

/*mart_customer_lifetime_value con CLV por cliente, número de transacciones por
canal, primera y última compra, tasa de devolución, y un campo value_segment
(alto/medio/bajo) usando umbrales fijos basados en TPC‑DS Snowflake.*/

with unified_sales as (
    select * from RETAILCO_DEV.RAW.int_unified_sales
),

unified_returns as (
    select * from RETAILCO_DEV.RAW.int_unified_return
)

select
    -- Claves y dimensiones
    s.bill_customer_sk,
    s.bill_customer_demo_sk,
    s.bill_household_demo_sk,
    s.bill_address_sk,

    -- Métricas de ventas (CLV = total_revenue)
    sum(s.ext_sales_price) as total_revenue,
    count(distinct s.order_number) as total_transactions,
    min(s.sold_date_sk) as first_purchase_date_sk,
    max(s.sold_date_sk) as last_purchase_date_sk,

    -- Métricas de devoluciones
    sum(r.return_amount) as total_return_amount,
    count(distinct case when r.return_amount > 0 then s.order_number end) as return_transactions,

    -- Tasa de devolución
    case 
        when sum(s.ext_sales_price) > 0 
        then sum(r.return_amount) / sum(s.ext_sales_price)
        else 0 
    end as return_rate,

    -- Segmento de valor basado en umbrales fijos TPC‑DS
    case
        when sum(s.ext_sales_price) >= 5000 then 'alto'
        when sum(s.ext_sales_price) >= 1000 then 'medio'
        else 'bajo'
    end as value_segment

from unified_sales s
left join unified_returns r 
    on s.order_number = r.order_number
group by 1,2,3,4
    )

/* {"app": "dbt", "dbt_version": "2.0.0", "node_id": "model.jaffle_shop.mart_customer_lifetime_value", "profile_name": "jaffle_shop", "target_name": "dev"} */
