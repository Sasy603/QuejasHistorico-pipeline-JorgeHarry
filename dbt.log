create or replace   view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_customer
  
  
  
  
  as (
    


/*
    This model is responsible for transforming the raw customer data into a more structured format.
    It handles data cleansing, type conversions, and derives additional attributes such as birth_date and customer_age.

    full_name (nombre completo)

    is_adult

    age_group (segmentación)

    email_domain

    customer_tenure (años desde primera compra)

    is_new_customer
*/
select
    COALESCE(c_customer_sk::INTEGER, -1) as customer,
    COALESCE(c_customer_id::VARCHAR, 'UNKNOWN') as customer_id,
    COALESCE(c_current_cdemo_sk::INTEGER, -1) as current_cdemo_sk,
    COALESCE(c_current_hdemo_sk::INTEGER, -1) as current_hdemo_sk,
    COALESCE(c_current_addr_sk::INTEGER, -1) as current_addr_sk,
    COALESCE(c_first_shipto_date_sk::INTEGER, -1) as first_shipto_date_sk,
    COALESCE(c_first_sales_date_sk::INTEGER, -1) as first_sales_date_sk,

    COALESCE(NULLIF(TRIM(c_salutation::VARCHAR), ''), 'UNKNOWN') as salutation,
    COALESCE(NULLIF(TRIM(c_first_name::VARCHAR), ''), 'UNKNOWN') as first_name,
    COALESCE(NULLIF(TRIM(c_last_name::VARCHAR), ''), 'UNKNOWN') as last_name,
    COALESCE(NULLIF(TRIM(c_preferred_cust_flag::VARCHAR), ''), 'N') as preferred_cust_flag,

    COALESCE(c_birth_day::INTEGER, 0) as birth_day,
    COALESCE(c_birth_month::INTEGER, 0) as birth_month,
    COALESCE(c_birth_year::INTEGER, 0) as birth_year,

    COALESCE(NULLIF(TRIM(c_birth_country::VARCHAR), ''), 'UNKNOWN') as birth_country,
    COALESCE(NULLIF(TRIM(c_login::VARCHAR), ''), 'UNKNOWN') as login,
    COALESCE(NULLIF(TRIM(c_email_address::VARCHAR), ''), 'UNKNOWN') as email_address,

    COALESCE(c_last_review_date::DATE, DATE '1900-01-01') as last_review_date,

    DATE_FROM_PARTS(c_birth_year, c_birth_month, c_birth_day) AS birth_date,

    DATEDIFF(
        year,
        DATE_FROM_PARTS(c_birth_year, c_birth_month, c_birth_day),
        CURRENT_DATE()
    ) AS customer_age

from RETAILCO_DEV.RAW.customer
  )
