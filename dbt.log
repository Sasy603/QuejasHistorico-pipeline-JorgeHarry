create or replace   view RETAILCO_DEV.MARTS.mart_inventory_health
  
  
  
  
  as (
    

with inv as (
    select
        item_sk,
        warehouse_sk,
        date_sk,
        quantity_on_hand
    from RETAILCO_DEV.staging.stg_inventory
),

sales as (
    select
        item_sk,
        warehouse_sk,
        sold_date_sk,
        quantity
    from RETAILCO_DEV.RAW.int_unified_sales
),

-- Normalizamos fechas a semana
inv_weekly as (
    select
        item_sk,
        warehouse_sk,
        date_trunc('week', to_date(cast(date_sk as varchar))) as week_start,
        avg(quantity_on_hand) as avg_stock_week
    from inv
    group by 1,2,3
),

sales_weekly as (
    select
        item_sk,
        warehouse_sk,
        date_trunc('week', to_date(cast(sold_date_sk as varchar))) as week_start,
        sum(quantity) as weekly_sales
    from sales
    group by 1,2,3
),

combined as (
    select
        i.item_sk,
        i.warehouse_sk,
        i.week_start,
        i.avg_stock_week,
        coalesce(s.weekly_sales, 0) as weekly_sales
    from inv_weekly i
    left join sales_weekly s
        on i.item_sk = s.item_sk
        and i.warehouse_sk = s.warehouse_sk
        and i.week_start = s.week_start
),

-- Tendencia usando window functions
trend_calc as (
    select
        *,
        lag(avg_stock_week) over (
            partition by item_sk, warehouse_sk
            order by week_start
        ) as prev_stock
    from combined
)

select
    item_sk,
    warehouse_sk,

    -- Stock medio semanal
    avg(avg_stock_week) as stock_medio_semanal,

    -- Ventas semanales medias
    avg(weekly_sales) as ventas_semanales_medias,

    -- Semanas de stock
    case 
        when avg(weekly_sales) > 0 
        then avg(avg_stock_week) / avg(weekly_sales)
        else null
    end as semanas_de_stock,

    -- Semanas con rotura de stock
    sum(case when avg_stock_week = 0 then 1 else 0 end) as semanas_con_rotura_stock,

    -- Tendencia basada en variación del stock
    case
        when avg(avg_stock_week - prev_stock) > 5 then 'creciente'
        when avg(prev_stock - avg_stock_week) > 5 then 'decreciente'
        else 'estable'
    end as tendencia

from trend_calc
group by 1,2
  )
