create or replace   view QUEJAS_AGRADECIMIENTOS_MADRID_HISTORICO.staging.stg_inventory
  
  
  
  
  as (
    

-- ============================================================================
--   Modelo: inventory
--   Descripción:
--     Estandariza la tabla de inventario proveniente del raw layer.
--
--   Transformaciones aplicadas:
--     - Casteo consistente de surrogate keys a INTEGER.
--     - Limpieza de NULLs y valores vacíos.
--     - Renombrado semántico de columnas.
-- ============================================================================

select
    -- Surrogate keys
    COALESCE(inv_date_sk::INTEGER, -1)       as date_sk,
    COALESCE(inv_item_sk::INTEGER, -1)       as item_sk,
    COALESCE(inv_warehouse_sk::INTEGER, -1)  as warehouse_sk,

    -- Métrica principal
    COALESCE(inv_quantity_on_hand::INTEGER, 0) as quantity_on_hand

from RETAILCO_DEV.RAW.inventory
  )
